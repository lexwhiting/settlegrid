    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "settlegrid",
    "mcp",
    "ai",
    "embeddings",
    "text-embeddings",
    "image-embeddings",
    "nomic",
    "atlas",
    "nlp",
    "machine-learning",
    "vectors",
    "semantic-search",
    "file-parsing"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/settlegrid/settlegrid-nomic-atlas"
  }
