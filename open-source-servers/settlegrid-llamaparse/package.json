    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "settlegrid",
    "mcp",
    "ai",
    "llamaparse",
    "llamaindex",
    "document-parsing",
    "pdf",
    "markdown",
    "ocr",
    "text-extraction",
    "ai",
    "llm",
    "document-ai"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/settlegrid/settlegrid-llamaparse"
  }
