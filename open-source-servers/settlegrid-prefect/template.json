      },
      "get_deployment": {
        "costCents": 1,
        "displayName": "Get Deployment"
      },
      "filter_deployments": {
        "costCents": 1,
        "displayName": "Filter Deployments"
      },
      "filter_logs": {
        "costCents": 2,
        "displayName": "Filter Logs"
      }
    }
  },
  "quality": {
    "tests": false
  },
  "capabilities": [
    "create_flow_run_from_deployment",
    "filter_deployments",
    "filter_flow_runs",
