{
  "framework": "nextjs",
  "installCommand": "cd ../.. && npm install",
  "buildCommand": "cd ../.. && npx turbo build --filter=@settlegrid/web",
  "crons": [
    {
      "path": "/api/cron/health-checks",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/webhook-retry",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/cron/alert-check",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/abandoned-checkout",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/expire-sessions",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/aggregate-usage",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/quality-check",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/monthly-summary",
      "schedule": "0 9 1 * *"
    },
    {
      "path": "/api/cron/weekly-report",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/cron/claim-outreach",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/data-retention",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/ecosystem-metrics",
      "schedule": "0 9 * * 0"
    },
    {
      "path": "/api/cron/anomaly-detection",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/claim-follow-up",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/consumer-schedules",
      "schedule": "*/5 * * * *"
    }
  ],
  "rewrites": [
    {
      "//": "P4.MKT2 — public x402 facilitator on a vanity subdomain. The `has` host filter scopes the rewrite so that ONLY requests to facilitator.settlegrid.ai/v1/* get routed to the internal /api/x402/facilitator/v1/* handlers; settlegrid.ai/v1/* (if it ever existed) would not match this rule and fall through to default routing.",
      "source": "/v1/:path*",
      "has": [
        { "type": "host", "value": "facilitator.settlegrid.ai" }
      ],
      "destination": "/api/x402/facilitator/v1/:path*"
    }
  ]
}
