        "costCents": 3,
        "displayName": "Translate Content"
      },
      "get_api_status": {
        "costCents": 1,
        "displayName": "Get API Status"
      },
      "get_translations": {
        "costCents": 1,
        "displayName": "Get Translations"
      },
      "update_translations": {
        "costCents": 3,
        "displayName": "Update Translations"
      }
    }
  },
  "quality": {
    "tests": false
  },
  "capabilities": [
    "get_api_status",
    "get_translations",
    "translate_content",
    "update_translations"
  ],
  "featured": false
